# Copiá este archivo a ".env" y completá los valores reales.
# NUNCA subas el archivo ".env" a un repositorio público.

# Puerto donde corre el backend
PORT=4000

# Secreto para firmar los JWT (usá una cadena larga y aleatoria, ej: openssl rand -hex 64)
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio

# Tiempo de expiración del token
JWT_EXPIRES_IN=7d

# Origen permitido para CORS (tu dominio de frontend en producción)
CORS_ORIGIN=http://localhost:5173

# Número de "salt rounds" para bcrypt (10-12 es un buen balance seguridad/rendimiento)
BCRYPT_SALT_ROUNDS=12

# Ruta del archivo de base de datos SQLite
DB_PATH=./data/bigbubble.db
